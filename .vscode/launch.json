{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Hermes with Expo (Node)",
            "type": "node",
            "request": "attach",
            "address": "localhost",
            "port": 8081,
            "restart": true,
            "sourceMaps": true,
            "cwd": "${workspaceFolder}",
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ],
            "sourceMapPathOverrides": {
                "webpack:///./~/*": "${workspaceFolder}/node_modules/*",
                "webpack:///./*": "${workspaceFolder}/*",
                "webpack:///*": "*"
            },
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Debug Hermes (Node)",
                "type": "node",
                "request": "attach",
                "address": "localhost",
                "port": 8081,
                "restart": true,
                "sourceMaps": true,
                "cwd": "${workspaceFolder}",
                "outFiles": ["${workspaceFolder}/src/**/*.js"],
                "sourceMapPathOverrides": {
                    "webpack:///./~/*": "${workspaceFolder}/node_modules/*",
                    "webpack:///./*": "${workspaceFolder}/src/*",
                    "webpack:///*": "${workspaceFolder}/src/*"
                  },
                "skipFiles": ["<node_internals>/**"]
              },
        {
            "name": "Debug Android",
            "type": "reactnative",
            "request": "launch",
            "platform": "android",
            "sourceMaps": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug iOS Hermes",
            "request": "launch",
            "type": "reactnativedirect",
            "cwd": "${workspaceFolder}",
            "platform": "ios"
        },
        {
            "name": "Debug iOS - Experimental",
            "request": "launch",
            "type": "reactnative",
            "cwd": "${workspaceFolder}",
            "platform": "ios"
        },
        {
            "name": "Launch Program",
            "program": "${workspaceFolder}/app.js",
            "request": "launch",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "name": "Attach to packager",
            "type": "reactnative",
            "request": "attach",
            "port": 8081,
            "sourceMaps": true,
            "cwd": "${workspaceFolder}"
        }
    ]
}